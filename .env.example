# ===== upload server configuration =====
# Copy this file to .env and edit the values.

# Port the server listens on
PORT=3000

# Public base URL used in generated links.
# Leave empty to auto-detect your LAN IP, e.g. http://192.168.1.50:3000
# Set this if you have a domain or reverse proxy:
#BASE_URL=https://up.example.com

# Where uploaded files are stored on disk
UPLOAD_DIR=./uploads

# Where the SQLite database lives
DB_PATH=./data/upload.db

# Max upload size in megabytes
MAX_UPLOAD_MB=20

# Allowed file extensions (comma separated, no dots)
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,svg,avif,bmp,ico,mp4,webm,mp3,wav,ogg,txt,json,zip

# Allow new user registration on the website (1 = yes, 0 = no)
REGISTRATION_OPEN=1

# Username that is forced to be admin on startup (comma separated for several)
ADMIN_USERNAME=

# Random filename length (upload.systems style short names)
NAME_LENGTH=8

# Rate limits
UPLOAD_RATE_PER_MINUTE=30
LOGIN_RATE_PER_15_MIN=15
REGISTER_RATE_PER_HOUR=5