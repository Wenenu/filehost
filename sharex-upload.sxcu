{
  "Version": "13.0.1",
  "Name": "upload.wested.lol",
  "DestinationType": "ImageUploader, FileUploader, TextUploader",
  "RequestMethod": "POST",
  "RequestURL": "https://upload.wested.lol/api/upload",
  "Headers": {
    "Key": "REPLACE_WITH_YOUR_API_KEY"
  },
  "Body": "MultipartFormData",
  "FileFormName": "file",
  "Arguments": {
    "json": "url"
  },
  "ResponseType": "Text",
  "URL": "$json:url$"
}